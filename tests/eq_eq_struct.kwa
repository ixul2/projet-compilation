int n1, n2;
foo a, b, c, d;

class foo {
  int x;
  int y;
  void constructor(int x, int y){
    this.x = x;
    this.y = y;
  }
}

main {
  n1 = 5;
  n2 = 5;
  print(n1==n2);
  print(n1===n2);
  n1 = 6;
  print(n1!=n2);
  print(n1=/=n2);
  a = new foo(1, 2);
  b = a;
  c = new foo(1, 2);
  d = new foo(2, 2);
  print(a==b);
  print(a===b);
  print(a==c);
  print(a=/=c);
  print(a!=d);
  print(a=/=d);
  // Ne doit renvoyer que des true
}